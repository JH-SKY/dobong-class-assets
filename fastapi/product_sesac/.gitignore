# 1. 가상환경 (내 방에만 있는 전용 도구함)
# 다른 사람 컴퓨터에는 그 사람만의 도구함이 있으니 공유할 필요가 없어요.
venv/
.venv/
env/

# 2. 파이썬 실행 시 생기는 찌꺼기 파일
# 코드를 실행할 때 컴퓨터가 임시로 만드는 파일들이라 깃허브엔 필요 없어요.
**/__pycache__/
*.py[cod]
*$py.class

# 3. 보안 정보 (현관문 비밀번호)
# DB 주소, API 키 등 중요한 비밀번호가 들어있는 파일입니다. 
# 절대 깃허브에 올라가면 안 돼요!
.env

# 4. 에디터 설정 (내 책상 배치도)
# 내가 VS Code를 쓰든 PyCharm을 쓰든 내 개인 설정일 뿐이라 공유하지 않아요.
.vscode/
.idea/

# 5. OS 생성 파일 (맥이나 윈도우가 몰래 만드는 파일)
.DS_Store
Thumbs.db

# 6. 로그 파일 (작업 일지)
# 프로그램이 돌아가면서 남기는 기록물인데, 용량만 차지해요.
*.log